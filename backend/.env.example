# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=xone-meeting-plugin
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=xone_user
POSTGRES_PASSWORD=xone_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xone_meetings

# Constructed by config.py — do not edit below
# DATABASE_URL=postgresql+asyncpg://xone_user:xone_pass@localhost:5432/xone_meetings

# ── Ollama AI ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=120

# ── PDF Export ────────────────────────────────────────────────────────────────
PDF_OUTPUT_DIR=./generated_pdfs

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
